# AlmiKorean env template. Copy to .env (git-ignored). Never commit real secrets.
#
# This file is documentation as well as a template: it is the list the audit's L4v check reads,
# so every variable the code touches belongs here even when it has no sensible default. Five
# were missing (ADMIN_API_SECRET, EMAIL_FROM, NEXT_PUBLIC_APP_URL, RESEND_API_KEY,
# ROUTER_WEBHOOK_SECRET) — a secret nobody documented is a secret nobody rotates.

# Neon Postgres. Runtime uses the POOLED host and MUST carry pgbouncer=true (network gotcha).
DATABASE_URL="postgresql://USER:PASSWORD@POOLED-HOST/DB?sslmode=require&pgbouncer=true"
# Direct (unpooled) host for prisma migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT-HOST/DB?sslmode=require"

APP_URL="https://almikorean.almiworld.com"
# Used to build absolute links in emails and the verify-email redirect. Unset, the code falls
# back to the request origin (routes) or the production domain (email links).
NEXT_PUBLIC_APP_URL="https://almikorean.almiworld.com"

# Access tiers (comma-separated emails). OWNER = unlimited/premium bypass; ADMIN = /admin panel.
OWNER_EMAILS="almiworld@almiworld.com"
ADMIN_EMAILS="almiworld@almiworld.com"

# Billing (Stripe). Billing stays OFF (fail-closed) until BOTH the secret key and price id are set.
# Founder creates the "AlmiKorean Pro" product ($12/mo, 7-day trial) in the shared AlmiWorld Stripe account.
# The 7-day trial is Stripe's own `trialing` status (card saved, not charged) — not an app-side timer.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# AI criteria feedback for TOPIK II Writing (lib/ai/anthropic-client.ts).
# Absent → /api/ko/writing returns an honest 503. It NEVER falls back to a fabricated estimate.
ANTHROPIC_API_KEY=""

# Email (Resend). Sends verification + welcome mail. Absent → signup still succeeds and the user
# can resend from their account; the send is best-effort by design.
# EMAIL_FROM is the single network-wide sender address.
RESEND_API_KEY=""
EMAIL_FROM="AlmiKorean <almiworld@almiworld.com>"

# Guards GET /api/admin/stats (header: x-admin-secret) — read by AlmiWorld HQ and AlmiMonitor.
# FAIL-CLOSED: unset means the endpoint always 401s, so it is never open by default.
# ⚠️ ONE value across the whole AlmiWorld network — never regenerate it per product.
ADMIN_API_SECRET=""

# Authenticates the consolidated Stripe webhook router (almi-billing-router) when it forwards
# an event to this product.
ROUTER_WEBHOOK_SECRET=""

# ── Local tooling only (scripts/audio/*) ─────────────────────────────────────
# Needed only to re-render or re-upload the listening clips. The app reads the committed
# manifest at src/data/audio-manifest.json and never touches these.
# BLOB_READ_WRITE_TOKEN is a WRITE credential: export it for the length of an upload, then unset
# it. Never commit it.
BLOB_READ_WRITE_TOKEN=""
AUDIO_OUT=""
AUDIO_MANIFEST=""

# ── Not set by hand ──────────────────────────────────────────────────────────
# NODE_ENV is set by the runtime.
# PROOF_UNAUTHENTICATED / PROOF_UNPAID are toggled inside the offline proof scripts to exercise
# the 401 and 402 branches. They have no meaning in a running app.
